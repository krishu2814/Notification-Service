# Notification Service Configuration
PORT=5015
MONGO_URL=mongodb://localhost:27017/ecommerce_notification
SECRET_TOKEN=ecommerce_jwt_secret_dev_key
JWT_SECRET=ecommerce_jwt_secret_dev_key
RABBITMQ_URL=amqp://guest:guest@localhost:5672
EXCHANGE_NAME=ecommerce_events
DLX_EXCHANGE_NAME=ecommerce_dlx
NODE_ENV=development

# SMTP Email Configuration (Optional - Defaults to Ethereal mock for local dev)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=mock_user@ethereal.email
SMTP_PASS=mock_pass
EMAIL_FROM="Ecommerce Platform" <no-reply@ecommerce.com>
